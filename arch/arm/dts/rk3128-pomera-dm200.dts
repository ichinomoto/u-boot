/dts-v1/;

#include <arm/rockchip/rk3128.dtsi>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "King Jim Pomera DM200";
	compatible = "kingjim,pomera-dm200", "rockchip,rk3128";

	aliases {
		mmc0 = &emmc;
		mmc1 = &sdmmc;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <128>;
		enable-gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&backlight_enable>;
		pwms = <&pwm0 0 25000 PWM_POLARITY_INVERTED>;
	};

	panel {
		compatible = "panel-lvds";
		backlight = <&backlight>;
		data-mapping = "jeida-18";
		enable-gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
		height-mm = <90>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_enable>;
		width-mm = <154>;

		panel-timing {
			clock-frequency = <51200000>;
			hactive = <1024>;
			vactive = <600>;
			hback-porch = <100>;
			hfront-porch = <210>;
			hsync-len = <10>;
			vback-porch = <8>;
			vfront-porch = <25>;
			vsync-len = <2>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <0>;
		};

		port {
			panel_in_lvds: endpoint {
				remote-endpoint = <&lvds_out_panel>;
			};
		};
	};

	buttons {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&recovery_keys>;

		key-right-shift {
			label = "Right Shift";
			linux,code = <KEY_RIGHTSHIFT>;
			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
		};
		key-left-alt {
			label = "Left Alt";
			linux,code = <KEY_LEFTALT>;
			gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>;
		};
		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
		};
	};
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <50000000>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
	status = "okay";
};

&display_subsystem {
	status = "okay";
};

&dphy {
	status = "okay";
};

&grf {
	lvds: lvds {
		compatible = "rockchip,rk3126-lvds";
		phys = <&dphy>;
		phy-names = "dphy";
		rockchip,grf = <&grf>;
		rockchip,output = "lvds";
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				lvds_in_vop: endpoint {
					remote-endpoint = <&vop_out_lvds>;
				};
			};

			port@1 {
				reg = <1>;

				lvds_out_panel: endpoint {
					remote-endpoint = <&panel_in_lvds>;
				};
			};
		};
	};
};

&sdmmc {
	broken-cd;
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <37500000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&i2c0 {
	clock-frequency = <100000>;
	status = "okay";

	pmic@1c {
		compatible = "rockchip,rk818";
		reg = <0x1c>;
		system-power-controller;

		regulators {
			vcc_sd: LDO_REG9 {
				regulator-name = "vcc_sd";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
			};
		};
	};
};

&pinctrl {
	dm200 {
		recovery_keys: recovery-keys {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_default>,
					<0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_default>,
					<0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};

	display {
		backlight_enable: backlight-enable {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		panel_enable: panel-enable {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "disabled";
};

&vop {
	status = "okay";

	port {
		vop_out_lvds: endpoint@2 {
			reg = <2>;
			remote-endpoint = <&lvds_in_vop>;
		};
	};
};
